{
  "name": "abstract-art-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "纯前端、零后端的「上传图片 → 生成抽象画」工具，BYOK，部署到 GitHub Pages。",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
